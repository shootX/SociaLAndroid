<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The library (database, thumbnails, settings) is backed up; the account token is not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
    </device-transfer>
</data-extraction-rules>
